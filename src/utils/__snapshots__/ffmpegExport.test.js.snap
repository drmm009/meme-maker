exports[`exportVideoFFmpeg command > mp4: two videos with a transition, a photo, a GIF sticker, text and two sounds 1`] = `
{
  "files": [
    "input_2.mp4",
    "input_3.mp4",
    "input_4.png",
    "input_5.gif",
    "text_6.png",
    "audio_7.webm",
    "audio_8.mp3",
  ],
  "filters": [
    "[2:a]atrim=0:3,asetpts=PTS-STARTPTS,aformat=channel_layouts=stereo:sample_rates=44100,afade=t=in:st=0:d=0.300,afade=t=out:st=2.700:d=0.300,volume=0.8[aud2]",
    "[2:v]setpts=(PTS-STARTPTS)/1+0/TB,scale=1280:720,scale=w='1280*(1+0.25*if(between((t-1.000),0,0.08),(t-1.000)/0.08,if(between((t-1.000),0.08,0.400),pow(1-((t-1.000)-0.08)/0.32,2),0)))':h='720*(1+0.25*if(between((t-1.000),0,0.08),(t-1.000)/0.08,if(between((t-1.000),0.08,0.400),pow(1-((t-1.000)-0.08)/0.32,2),0)))':eval=frame,crop=1280:720,colorchannelmixer=rr=0.2130:rg=0.7150:rb=0.0720:gr=0.2130:gg=0.7150:gb=0.0720:br=0.2130:bg=0.7150:bb=0.0720,lutrgb=r='clip((min(val*1.0000,255)-127.5)*1.1000+127.5,0,255)':g='clip((min(val*1.0000,255)-127.5)*1.1000+127.5,0,255)':b='clip((min(val*1.0000,255)-127.5)*1.1000+127.5,0,255)',format=yuva420p,fade=t=out:st=2.750:d=0.250:alpha=1[vis2]",
    "[0:v][vis2]overlay=0:0:enable='between(t,0,3)':eof_action=pass:shortest=0[bg1]",
    "[3:v]setpts=(PTS-STARTPTS)/1.5+3/TB,scale=1280:720,format=yuva420p,chromakey=0x00FF00:0.300:0.100,despill=type=green,format=yuva420p,fade=t=in:st=3.000:d=0.250:alpha=1[vis3]",
    "[bg1][vis3]overlay=0:0:enable='between(t,3,5)':eof_action=pass:shortest=0[bg2]",
    "[4:v]setpts=(PTS-STARTPTS)/1,scale=384:288,colorchannelmixer=rr=0.8820:rg=0.1072:rb=0.0108:gr=0.0320:gg=0.9572:gb=0.0108:br=0.0320:bg=0.1072:bb=0.8608,colorchannelmixer=rr=0.7268:rg=0.3460:rb=0.0850:gr=0.1570:gg=0.8587:gb=0.0756:br=0.1224:bg=0.2403:bb=0.6090,lutrgb=r='clip((min(val*1.1550,255)-127.5)*1.0500+127.5,0,255)':g='clip((min(val*1.1550,255)-127.5)*1.0500+127.5,0,255)':b='clip((min(val*1.1550,255)-127.5)*1.0500+127.5,0,255)'[vis4]",
    "[bg2][vis4]overlay=160:80:enable='between(t,1,4)':eof_action=pass:shortest=0[bg3]",
    "[5:v]setpts=(PTS-STARTPTS)/1+0/TB,scale=192:192[vis5]",
    "[bg3][vis5]overlay=960:32:enable='between(t,0,5)':eof_action=pass:shortest=0[bg4]",
    "[bg4][6:v]overlay=0:0:enable='between(t,0.000,5.000)':eof_action=pass:shortest=0[bg5]",
    "[7:a]atrim=0:1,asetpts=PTS-STARTPTS,aformat=channel_layouts=stereo:sample_rates=44100,adelay=1000|1000,volume=0.5[aud7]",
    "[8:a]atrim=0:0.8,asetpts=PTS-STARTPTS,atempo=2,aformat=channel_layouts=stereo:sample_rates=44100,volume=1[aud8]",
    "[1:a][aud2][aud7][aud8]amix=inputs=4:duration=first:dropout_transition=0,volume=4[final_audio]",
  ],
  "inputs": [
    "-f",
    "lavfi",
    "-i",
    "color=c=0x1A1D27:s=1280x720:d=5",
    "-f",
    "lavfi",
    "-i",
    "anullsrc=r=44100:cl=stereo:d=5",
    "-ss",
    "0.5",
    "-i",
    "input_2.mp4",
    "-i",
    "input_3.mp4",
    "-loop",
    "1",
    "-i",
    "input_4.png",
    "-ignore_loop",
    "0",
    "-i",
    "input_5.gif",
    "-loop",
    "1",
    "-i",
    "text_6.png",
    "-ss",
    "0.2",
    "-i",
    "audio_7.webm",
    "-i",
    "audio_8.mp3",
  ],
  "output": [
    "-map",
    "[bg5]",
    "-map",
    "[final_audio]",
    "-c:v",
    "libx264",
    "-preset",
    "ultrafast",
    "-c:a",
    "aac",
    "-b:a",
    "192k",
    "-t",
    "5",
    "output.mp4",
  ],
  "texts": [
