+                      onChange={(e) => {
+                        const hex = e.target.value;
+                        const strokeColor = hex === '#000000' ? '#ffffff' : '#000000';
+                        if (!activeLayerId) return;
+                        const nextCaps = captions.map((cap) => 
+                          cap.id === activeLayerId ? { ...cap, color: hex, stroke: strokeColor } : cap
+                        );
+                        setCaptions(nextCaps);
+                        pushHistory(nextCaps, stickers);
+                      }}
+                    />
+                  </div>
+                )}
+
+                {activeCaption && (
+                  <button className="btn btn-icon btn-xs text-danger" onClick={handleDeleteLayer} title="Delete Text">
+                    <Trash2 className="icon-xs" />
+                  </button>
+                )}
+              </div>
+
+              {activeCaption && (
+                <div className="form-row margin-top-xs flex-between gap-xs align-center" style={{ display: 'flex', width: '100%' }}>
+                  {/* Font Style Button on LEFT (Compact Width) */}
+                  <div className="form-field" style={{ flex: '0 0 38%', maxWidth: '120px', minWidth: 0 }}>
+                    <label>Font Style</label>
+                    <button
+                      type="button"
+                      className="btn btn-xs btn-secondary font-cycle-btn flex-between"
+                      style={{
+                        fontFamily: activeFontObj.family,
+                        width: '100%',
+                        padding: '0 6px',
+                        height: '38px',
+                        fontSize: '0.8rem',
+                        boxSizing: 'border-box',
+                        overflow: 'hidden'
+                      }}
+                      onClick={handleCycleFont}
+                      title="Tap to change font"
+                    >
+                      <span style={{ whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis', marginRight: '2px' }}>
+                        Aa {activeFontObj.name.split(' ')[0]}
+                      </span>
+                      <RefreshCw className="icon-xs text-cyan" style={{ flexShrink: 0 }} />
+                    </button>
+                  </div>
+
+                  {/* Size Control on RIGHT (Expands to Fill Space) */}
+                  <div className="form-field" style={{ flex: '1 1 auto', minWidth: 0 }}>
+                    <label>Size ({activeCaption.fontSize || 50}px)</label>
+                    <div className="size-control-group flex-between gap-xs" style={{ height: '38px', alignItems: 'center' }}>
+                      <button
+                        type="button"
+                        className="btn btn-xs btn-secondary"
+                        style={{ width: '30px', height: '30px', borderRadius: '50%', padding: 0, fontWeight: 'bold', display: 'flex', alignItems: 'center', justifyContent: 'center', fontSize: '1.1rem', flexShrink: 0 }}
+                        onClick={() => updateActiveCaption('fontSize', Math.max(16, (activeCaption.fontSize || 50) - 4))}
+                      >
+                        -
+                      </button>
+                      <input
+                        type="range"
+                        min={16}
+                        max={110}
+                        style={{ flex: 1, margin: '0 4px', minWidth: 0 }}
+                        value={activeCaption.fontSize || 50}
+                        onChange={(e) => updateActiveCaption('fontSize', Number(e.target.value))}
+                      />
+                      <button
+                        type="button"
+                        className="btn btn-xs btn-secondary"
+                        style={{ width: '30px', height: '30px', borderRadius: '50%', padding: 0, fontWeight: 'bold', display: 'flex', alignItems: 'center', justifyContent: 'center', fontSize: '1.1rem', flexShrink: 0 }}
+                        onClick={() => updateActiveCaption('fontSize', Math.min(110, (activeCaption.fontSize || 50) + 4))}
+                      >
+                        +
+                      </button>
+                    </div>
+                  </div>
+                </div>
+              )}
+
+              {/* Trending Preset Phrases */}
+              <div className="preset-phrases-section margin-top">
+                <label className="form-field-label">Quick Phrases</label>
+                <div className="preset-chips-scroll">
+                  {PRESET_PHRASES.map((phrase) => (
+                    <button
+                      key={phrase}
+                      className="btn btn-xs btn-ghost phrase-chip"
+                      onClick={() => handleAddPresetPhrase(phrase)}
+                    >
+                      + {phrase}
+                    </button>
+                  ))}
+                </div>
+              </div>
+            </div>
+          )}
+
+          {/* TAB 2: STICKERS CONTROLS */}
+          {activeTab === 'stickers' && (
+            <div className="tab-content">                {activeSticker ? (
+                  <div className="flex-between align-center margin-bottom-sm glass-card" style={{ padding: '8px 12px', gap: '12px' }}>
+                    <span className="sticker-selected-badge" style={{ fontSize: '1.5rem', margin: 0, padding: 0, background: 'transparent', flexShrink: 0 }}>
+                      {activeSticker.emoji}
+                    </span>
+                    <input
+                      type="range"
+                      min="0.2"
+                      max="5.0"
+                      step="0.1"
+                      value={activeSticker.scale || 1.0}
+                      onChange={(e) => updateActiveStickerScale(parseFloat(e.target.value))}
+                      style={{ flex: 1, margin: '0 8px' }}
+                    />
+                    <button className="btn btn-icon btn-xs text-danger" onClick={handleDeleteLayer} title="Delete Sticker" style={{ padding: '4px', flexShrink: 0 }}>
+                      <Trash2 className="icon-xs" />
+                    </button>
+                  </div>
+                ) : (
+                  <div className="flex-between margin-bottom-xs">
+                  <span className="text-muted form-field-label">Tap emoji below to add sticker</span>
+                </div>
+              )}
+
+              {/* High Density Emoji Palette Grid */}
+              <div className="stickers-emoji-grid">
+                {STICKERS.map((stk) => (
+                  <button
+                    key={stk.id}
+                    className="sticker-chip-btn hover-lift"
+                    title={stk.name}
+                    onClick={() => handleAddSticker(stk)}
+                  >
+                    {stk.emoji}
+                  </button>
+                ))}
+              </div>
+            </div>
+          )}
+
+          {/* TAB 3: MEDIA OVERLAY CONTROLS */}
+          {activeTab === 'images' && (() => {
+            const isVideoLayer = activeImageLayer && isVideoUrl(activeImageLayer.url);
+            return (
+              <div className="tab-content">
+                {/* Header Action Buttons: Upload Photo/Video | Pick Template */}
+                <div className="flex-between margin-bottom-sm align-center flex-wrap gap-2">
+                  <div style={{ display: 'flex', gap: '8px' }}>
+                    <label className="btn btn-xs btn-primary hover-lift" title="Upload Image or Video">
+                      <Upload className="icon-xs" /> Upload Media
+                      <input
+                        type="file"
+                        accept="image/*,video/*"
+                        style={{ display: 'none' }}
+                        onChange={handleFileUploadImageLayer}
+                      />
+                    </label>
+                    <button className="btn btn-xs btn-secondary hover-lift" onClick={() => setImagePickerTarget('layer')}>
+                      <ImageIcon className="icon-xs" /> Pick Template
+                    </button>
+                  </div>
+
+                  {activeImageLayer && (
+                    <button className="btn btn-icon btn-xs text-danger" onClick={handleDeleteLayer} title="Delete Media Layer">
+                      <Trash2 className="icon-xs" />
+                    </button>
+                  )}
+                </div>
+
+                {/* Active Media Layer Controls */}
+                {activeImageLayer ? (
+                  <div className="layer-controls glass-card" style={{ padding: '12px', marginTop: '10px' }}>
+                    <div className="form-group margin-bottom-xs" style={{ marginTop: '8px' }}>
+                      
+                      <div className="flex-between gap-2">
+                        <button 
+                          className={`btn btn-xs ${activeImageLayer.fitMode === 'fit' || !activeImageLayer.fitMode ? 'btn-primary' : 'btn-ghost'}`} 
+                          style={{ flex: 1 }}
+                          onClick={() => updateActiveImageLayer('fitMode', 'fit')}
+                        >
+                          Fit
+                        </button>
+                        <button 
+                          className={`btn btn-xs ${activeImageLayer.fitMode === 'crop' ? 'btn-primary' : 'btn-ghost'}`} 
+                          style={{ flex: 1 }}
+                          onClick={() => updateActiveImageLayer('fitMode', 'crop')}
+                        >
+                          Crop
+                        </button>
+                        <button 
+                          className={`btn btn-xs ${activeImageLayer.fitMode === 'stretch' ? 'btn-primary' : 'btn-ghost'}`} 
+                          style={{ flex: 1 }}
+                          onClick={() => updateActiveImageLayer('fitMode', 'stretch')}
+                        >
+                          Stretch
+                        </button>
+                      </div>
+                    </div>
+                  </div>
+                ) : (
+                  <div className="empty-state-mini" style={{ textAlign: 'center', padding: '20px 10px', color: 'var(--text-muted)' }}>
+                    <ImageIcon className="icon-md" style={{ opacity: 0.4, marginBottom: '6px' }} />
+                    <p style={{ fontSize: '0.8rem', margin: 0 }}>Upload an image or video to overlay on your canvas!</p>
+                  </div>
+                )}
+
+                {/* VideoTrimmer Modal ÔÇö rendered as portal to escape canvas z-index stacking context */}
+                {pendingVideoLayer && createPortal(
+                  <VideoTrimmer
+                    videoUrl={pendingVideoLayer}
+                    trimStart={0}
+                    trimEnd={null}
+                    onApply={(start, end) => {
+                      commitAddImageLayer(pendingVideoLayer, start, end);
+                      setPendingVideoLayer(null);
+                    }}
+                    onClose={() => setPendingVideoLayer(null)}
+                  />,
+                  document.body
+                )}
+              </div>
+            );
+          })()}</div>
+      </div>
+
+      {/* Export / Share Modal */}
+      {isExportModalOpen && (
+        <div className="modal-backdrop animate-fade-in" onClick={() => setIsExportModalOpen(false)}>
+          <div className="modal-content glass-card modal-md" onClick={(e) => e.stopPropagation()}>
+            <div className="modal-header" style={{ position: 'relative', display: 'flex', justifyContent: 'center', alignItems: 'center', marginBottom: '12px' }}>
+              <h3 style={{ display: 'flex', alignItems: 'center', gap: '8px', margin: 0 }}>
+                <Sparkles className="icon-sm text-cyan" /> Export Meme
+              </h3>
+              <button className="btn-close" onClick={() => setIsExportModalOpen(false)}>Ô£ò</button>
+            </div>
+            <div className="modal-body text-center">
+              {exportedImageUri && (
+                <img src={exportedImageUri} alt="Exported Meme" className="export-preview-img margin-bottom" />
+              )}
+              <div className="flex-center gap-3">
+                <button className="btn btn-primary shadow-glow" onClick={handleDownloadImage}>
+                  <Download className="icon-xs" /> Download PNG
+                </button>
+              </div>
+            </div>
+          </div>
+        </div>
+      )}
+
+      {/* Save Meme Naming Modal */}
+      {isSaveModalOpen && createPortal(
+        <div className="modal-backdrop animate-fade-in" onClick={() => setIsSaveModalOpen(false)}>
+          <div className="modal-content glass-card modal-md animate-scale-up" onClick={(e) => e.stopPropagation()}>
+            <div className="modal-header flex-between margin-bottom-xs">
+              <h3 style={{ display: 'flex', alignItems: 'center', gap: '8px', margin: 0 }}>
+                <Save className="icon-sm text-cyan" /> Save Meme to Gallery
+              </h3>
+              <button className="btn-close" onClick={() => setIsSaveModalOpen(false)}>Ô£ò</button>
+            </div>
+
+            <div className="modal-body">
+
+              <form onSubmit={(e) => { e.preventDefault(); handleConfirmSave(); }}>
+                <div className="form-field margin-bottom">
+                  <label>Meme Title / Name</label>
+                  <input
+                    type="text"
+                    className="form-input"
+                    placeholder="e.g. Funny Cat Meme"
+                    value={memeCustomName}
+                    onChange={(e) => setMemeCustomName(e.target.value)}
+                    autoFocus
+                  />
+                </div>
+
+                <div style={{ display: 'flex', justifyContent: 'flex-start', alignItems: 'center', gap: '12px', marginTop: '20px' }}>
+                  <button
+                    type="button"
+                    className="btn btn-secondary btn-sm"
+                    style={{ padding: '8px 16px', fontSize: '0.85rem', fontWeight: '600' }}
+                    onClick={() => setIsSaveModalOpen(false)}
+                  >
+                    Cancel
+                  </button>
+                  <button
+                    type="submit"
+                    className="btn btn-primary shadow-glow btn-sm"
+                    style={{ padding: '8px 18px', fontSize: '0.85rem', fontWeight: '700', display: 'flex', alignItems: 'center', gap: '6px' }}
+                  >
+                    <Check className="icon-xs" /> Save Meme
+                  </button>
+                </div>
+              </form>
+            </div>
+          </div>
+        </div>,
+        document.body
+      )}
+
+      {/* Image Layer Template Picker Modal */}
+      {imagePickerTarget !== null && (
+        <div className="modal-backdrop animate-fade-in" onClick={() => setImagePickerTarget(null)}>
+          <div className="modal-content glass-card modal-md" onClick={(e) => e.stopPropagation()} style={{ maxWidth: '640px' }}>
+            <div className="modal-header flex-between" style={{ alignItems: 'center', marginBottom: '10px' }}>
+              <h3>Add Meme Overlay Photo</h3>
+              <button className="btn-close" onClick={() => setImagePickerTarget(null)}>Ô£ò</button>
+            </div>
+
+            <div className="picker-search-bar" style={{ position: 'relative', marginBottom: '14px' }}>
+              <Search className="search-icon" style={{ position: 'absolute', left: '12px', top: '50%', transform: 'translateY(-50%)', pointerEvents: 'none', color: 'var(--text-muted)' }} />
+              <input
+                type="text"
+                placeholder={`Search ${openSourceTemplates.length}+ meme templates...`}
+                value={imagePickerSearch}
+                onChange={(e) => setImagePickerSearch(e.target.value)}
+                className="search-input"
+                style={{ paddingLeft: '38px', paddingRight: imagePickerSearch ? '38px' : '14px', height: '42px', width: '100%', boxSizing: 'border-box' }}
+              />
+              {imagePickerSearch && (
+                <button
+                  onClick={() => setImagePickerSearch('')}
+                  style={{
+                    position: 'absolute', right: '10px', top: '50%', transform: 'translateY(-50%)',
+                    background: 'rgba(255,255,255,0.12)', border: 'none', borderRadius: '50%',
+                    width: '22px', height: '22px', display: 'flex', alignItems: 'center', justifyContent: 'center',
+                    color: 'var(--text-muted)', cursor: 'pointer'
+                  }}
+                >
+                  <X className="icon-xs" style={{ width: '13px', height: '13px' }} />
+                </button>
+              )}
+            </div>
+
+            <div className="template-picker-mini" style={{ maxHeight: '360px', overflowY: 'auto' }}>
+              {filteredImageTemplates.length > 0 ? (
+                filteredImageTemplates.map((tmpl) => (
+                  <div
+                    key={tmpl.id}
+                    className="mini-template-card glass-card hover-lift"
+                    onClick={() => {
+                      if (imagePickerTarget === 'layer') {
+                        handleAddImageLayer(tmpl.imageUrl);
+                      } else if (imagePickerTarget.slot !== undefined) {
+                        const nextImages = [...slotImages];
+                        nextImages[imagePickerTarget.slot] = tmpl.imageUrl;
+                        setSlotImages(nextImages);
+
+                        const nextTransforms = [...slotTransforms];
+                        nextTransforms[imagePickerTarget.slot] = { offsetX: 0, offsetY: 0, scale: 1.5 };
+                        setSlotTransforms(nextTransforms);
+                      }
+                      setImagePickerTarget(null);
+                      setImagePickerSearch('');
+                    }}
+                  >
+                    <img src={tmpl.imageUrl} alt={tmpl.name} loading="lazy" />
+                    <span>{tmpl.name}</span>
+                  </div>
+                ))
+              ) : (
+                <div style={{ textAlign: 'center', padding: '30px', color: 'var(--text-muted)' }}>
+                  <ImageIcon className="icon-lg" style={{ opacity: 0.4, marginBottom: '8px' }} />
+                  <p>No matching templates found for "{imagePickerSearch}"</p>
+                </div>
+              )}
+            </div>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
